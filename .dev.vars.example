# Copy to .dev.vars for local wrangler dev.
# Create a Google OAuth Web client (see README) first.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_ENCRYPTION_KEY=
MINIMAX_API_KEY=
FISH_API_KEY=
# Optional. Production sets https://whatbeatslearning.com in wrangler.jsonc.
# Local wrangler dev ignores that and uses the request host.
PUBLIC_ORIGIN=
