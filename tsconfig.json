{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"jsx": "react-jsx",
		"module": "es2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
